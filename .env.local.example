# Copy this file to .env.local and fill in the values. See SETUP.md.

# Postgres connection string — Vercel's Storage tab fills this in
# automatically as POSTGRES_URL once you attach a Postgres store; either name
# works, this app checks both.
DATABASE_URL=

# Named accounts, as a JSON object of name -> password (see SETUP.md).
# Example: {"Michael":"correcthorse1","Sarah":"correcthorse2"}
# Everyone logs in with just their own password — the tool figures out who
# it is from which password matched, so the login form stays one field.
AUTH_USERS=

# Legacy fallback: a single shared password used by everyone (kept working
# for existing deployments that haven't set AUTH_USERS yet). Ignored once
# AUTH_USERS is set.
AUTH_PASSWORD=

# A long random string used to sign the login session cookie. Generate one
# with: openssl rand -hex 32
AUTH_SECRET=
